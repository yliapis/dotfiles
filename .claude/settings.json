{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5[1m]",
  "alwaysThinkingEnabled": true,
  "effortLevel": "max",
  "fastMode": false,
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  }
}
