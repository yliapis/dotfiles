#!/bin/sh
# sync — propagate AI-coding commands/skills/rules from this dotfiles repo
# into per-tool home-directory locations via atomic symlinks. Commands and
# skills live inside the plugins under ai-coding/plugins/<plugin>/{commands,skills}
# and are flattened into one destination directory per tool and type.
#
# Synthesised from a four-way swarm: kept POSIX /bin/sh + `ln -sfn` symlinks
# (so source edits in this repo reflect immediately at the destination); added
# the richer `--help`, `info`/`notice`/`die` helpers, `--` argument terminator,
# and final summary block from the bash+rsync variant; type deduplication and
# the `[dry-run]` output prefix from the Python variant; and the repo-root
# sanity check from the staged-shell variant.

set -eu

prog="$(basename "$0")"

# ---- output helpers --------------------------------------------------------

die() {
    printf '%s: error: %s\n' "$prog" "$*" >&2
    exit 2
}

notice() {
    printf '%s: notice: %s\n' "$prog" "$*"
}

info() {
    printf '%s\n' "$*"
}

usage() {
    cat <<EOF
Usage: $prog --tool <TOOL> --type <TYPE> [--type <TYPE> ...] [--dry-run]

Symlink AI-coding commands, skills, and (eventually) rules from this dotfiles
repo into the destination directory of the chosen AI coding tool. Symlinks
are atomic (ln -sfn) and idempotent; source edits reflect immediately.

Required:
  --tool <TOOL>     One of: cursor, claude, opencode, codex
  --type <TYPE>     One of: command, skill, rule  (repeatable; deduped)

Optional:
  --dry-run         Print actions (prefixed with [dry-run]) without writing
  -h, --help        Show this help and exit

Environment:
  DOTFILES_REPO_ROOT  Override the repo root (default: two levels above
                      this script's directory).

Examples:
  $prog --tool cursor   --type command --type skill
  $prog --tool claude   --type skill --dry-run
  DOTFILES_REPO_ROOT=/tmp/repo $prog --tool codex --type command
EOF
}

# ---- argument parsing ------------------------------------------------------

TOOL=""
TYPES=""
DRY_RUN=0

while [ $# -gt 0 ]; do
    case "$1" in
        --tool)
            [ $# -ge 2 ] || die "--tool requires a value"
            TOOL="$2"; shift 2 ;;
        --tool=*)
            TOOL="${1#--tool=}"; shift ;;
        --type)
            [ $# -ge 2 ] || die "--type requires a value"
            TYPES="$TYPES $2"; shift 2 ;;
        --type=*)
            TYPES="$TYPES ${1#--type=}"; shift ;;
        --dry-run)
            DRY_RUN=1; shift ;;
        -h|--help)
            usage; exit 0 ;;
        --)
            shift; break ;;
        -*)
            usage >&2; die "unknown option: $1" ;;
        *)
            usage >&2; die "unexpected argument: $1" ;;
    esac
done

[ -n "$TOOL" ]  || { usage >&2; die "missing required --tool"; }
[ -n "$TYPES" ] || { usage >&2; die "missing required --type (at least once)"; }

case "$TOOL" in
    cursor|claude|opencode|codex) ;;
    *) die "invalid --tool '$TOOL' (expected: cursor, claude, opencode, codex)" ;;
esac

DEDUPED=""
for t in $TYPES; do
    case "$t" in
        command|skill|rule) ;;
        *) die "invalid --type '$t' (expected: command, skill, rule)" ;;
    esac
    case " $DEDUPED " in
        *" $t "*) ;;
        *) DEDUPED="${DEDUPED:+$DEDUPED }$t" ;;
    esac
done
TYPES="$DEDUPED"

# ---- repo root -------------------------------------------------------------

if [ -n "${DOTFILES_REPO_ROOT:-}" ]; then
    REPO_ROOT="$DOTFILES_REPO_ROOT"
else
    SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"
    REPO_ROOT="$(cd -P "$SCRIPT_DIR/../.." && pwd)"
fi

[ -d "$REPO_ROOT" ] || die "repo root not found: $REPO_ROOT"

SRC_PLUGINS="$REPO_ROOT/ai-coding/plugins"

# ---- destination registry --------------------------------------------------

dest_for() {
    case "$1:$2" in
        cursor:command)   printf '%s\n' "$HOME/.cursor/commands" ;;
        cursor:skill)     printf '%s\n' "$HOME/.cursor/skills" ;;
        cursor:rule)      printf '%s\n' "$HOME/.cursor/rules" ;;
        claude:command)   printf '%s\n' "$HOME/.claude/commands" ;;
        claude:skill)     printf '%s\n' "$HOME/.claude/skills" ;;
        claude:rule)      printf '%s\n' "$HOME/.claude/rules" ;;
        opencode:command) printf '%s\n' "$HOME/.config/opencode/commands" ;;
        opencode:skill)   printf '%s\n' "$HOME/.config/opencode/skills" ;;
        opencode:rule)    printf '%s\n' "$HOME/.config/opencode/rules" ;;
        codex:command)    printf '%s\n' "$HOME/.codex/prompts" ;;
        codex:skill)      printf '%s\n' "$HOME/.codex/skills" ;;
        codex:rule)       printf '%s\n' "$HOME/.codex/rules" ;;
        *) die "no destination mapping for $1:$2" ;;
    esac
}

# ---- action helpers (dry-run prefix disambiguates simulated vs executed) ---

ensure_dir() {
    if [ "$DRY_RUN" -eq 1 ]; then
        printf '[dry-run] mkdir -p %s\n' "$1"
    else
        printf 'mkdir -p %s\n' "$1"
        mkdir -p "$1"
    fi
}

link_one() {
    if [ "$DRY_RUN" -eq 1 ]; then
        printf '[dry-run] ln -sfn %s %s\n' "$1" "$2"
    else
        printf 'ln -sfn %s %s\n' "$1" "$2"
        ln -sfn "$1" "$2"
    fi
}

# ---- summary tracking ------------------------------------------------------

SUMMARY=""

add_summary() {
    if [ -z "$SUMMARY" ]; then
        SUMMARY="$1"
    else
        SUMMARY="$SUMMARY
$1"
    fi
}

# ---- per-type sync ---------------------------------------------------------

# ai-coding/plugins/<plugin>/<type>/<entry> -> <plugin>
plugin_of() {
    basename "$(dirname "$(dirname "$1")")"
}

# First plugin to claim a basename during the current collect pass.
claimant_of() {
    printf '%s' "$PAIRS" | while IFS=' ' read -r n p; do
        if [ "$n" = "$1" ]; then
            printf '%s' "$p"
            break
        fi
    done
}

# Every plugin's entries of a given type flatten into one destination
# directory, so the same basename in two plugins would race for a single
# symlink. That is a repo bug, not a preference: reject it before writing
# anything rather than letting the last plugin win.
sync_type() {
    type_name="$1"
    dest_dir="$2"
    kind_test="$3"
    pattern="$4"

    if [ ! -d "$SRC_PLUGINS" ]; then
        notice "plugin source missing at $SRC_PLUGINS; skipping --type $type_name"
        add_summary "$type_name: 0 -> $dest_dir (source missing)"
        return 0
    fi

    found=0
    SEEN=""
    PAIRS=""
    for src in "$SRC_PLUGINS"/*/$pattern; do
        [ "$kind_test" "$src" ] || continue
        name="$(basename "$src")"
        plugin="$(plugin_of "$src")"
        case " $SEEN " in
            *" $name "*)
                die "duplicate $type_name '$name' in plugins '$(claimant_of "$name")' and '$plugin'; basenames must be unique across plugins because they all flatten into $dest_dir"
                ;;
        esac
        SEEN="$SEEN $name"
        PAIRS="$PAIRS$name $plugin
"
        found=$((found + 1))
    done

    if [ "$found" -eq 0 ]; then
        notice "no ${type_name}s found under $SRC_PLUGINS/*/$pattern"
        add_summary "$type_name: 0 -> $dest_dir (none found)"
        return 0
    fi

    ensure_dir "$dest_dir"
    for src in "$SRC_PLUGINS"/*/$pattern; do
        [ "$kind_test" "$src" ] || continue
        link_one "$src" "$dest_dir/$(basename "$src")"
    done
    add_summary "$type_name: $found -> $dest_dir"
}

# ---- main ------------------------------------------------------------------

info "sync: tool=$TOOL types=$TYPES dry_run=$DRY_RUN"
info "sync: repo_root=$REPO_ROOT"
info ""

for t in $TYPES; do
    dest="$(dest_for "$TOOL" "$t")"
    case "$t" in
        command) sync_type command "$dest" -f 'commands/*.md' ;;
        skill)   sync_type skill   "$dest" -d 'skills/*' ;;
        rule)    sync_type rule    "$dest" -e 'rules/*' ;;
    esac
done

info ""
if [ "$DRY_RUN" -eq 1 ]; then
    info "=== summary (dry-run; no writes performed) ==="
else
    info "=== summary ==="
fi
printf '%s\n' "$SUMMARY" | while IFS= read -r line; do
    [ -n "$line" ] && info "  - $line"
done
