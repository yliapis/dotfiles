            "isDeleted": false,
            "boundElements": null,
            "updated": 1785136321182,
            "link": null,
            "locked": false,
            "text": "Drift gates: make mirrors-check, skills-index-check, and commands-index-check re-derive each generated tree and exit non-zero when it no longer matches its source.\nFlattening rule: every plugin's items land in one directory per tool per kind, so two plugins claiming one name abort the run instead of shadowing each other.",
            "fontSize": 16,
            "fontFamily": 5,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "Drift gates: make mirrors-check, skills-index-check, and commands-index-check re-derive each generated tree and exit non-zero when it no longer matches its source.\nFlattening rule: every plugin's items land in one directory per tool per kind, so two plugins claiming one name abort the run instead of shadowing each other.",
            "autoResize": true,
            "lineHeight": 1.25
        },
